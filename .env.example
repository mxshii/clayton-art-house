# Clayton Art House — Environment Configuration

# Supabase Credentials
# Find these in your Supabase project: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Admin Portal Configuration
# Optional: Set a default admin login email for local quick-access
VITE_ADMIN_DEFAULT_EMAIL=admin@claytonarthouse.com

# Egyptian Payment Gateway (Paymob Integration)
# In production, server-side Edge Functions handle transaction authorization
VITE_PAYMENT_MODE=test # Options: 'test' (mock gateway) or 'production' (Paymob live)
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_card_integration_id_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# Email Delivery (Resend Integration)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL_SENDER=bookings@claytonarthouse.com
VENUE_NOTIFICATION_EMAIL=hello@claytonarthouse.com

# Venue Metadata
VITE_VENUE_NAME="Clayton Art House"
VITE_VENUE_LOCATION="14 Rue Ahmed Zulfikar, Kafr Abdo, Alexandria, Egypt"
VITE_VENUE_PHONE="+20 102 345 6789"
